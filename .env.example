# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
HOST=127.0.0.1
PORT=8080
ENVIRONMENT=development

# ─────────────────────────────────────────────
# Database — Supabase PostgreSQL
# Find in: Supabase Dashboard → Project Settings → Database → Connection string
# ─────────────────────────────────────────────
# For SeaORM and migrations — direct connection
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# For high-traffic API requests — transaction pooler
DATABASE_POOL_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ─────────────────────────────────────────────
# Redis — Railway
# Find in: Railway Dashboard → Redis service → Connect → Redis URL
# For local development this is always:
# REDIS_URL=redis://localhost:6379
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# TMDB — The Movie Database
# Get your API key at: https://www.themoviedb.org/settings/api
# ─────────────────────────────────────────────
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ─────────────────────────────────────────────
# Supabase — Auth and JWT validation
# Find in: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_PER_SECOND=50
RATE_LIMIT_BURST_SIZE=100

# ─────────────────────────────────────────────
# Cache TTL (seconds)
# ─────────────────────────────────────────────
CACHE_TTL_MOVIE=604800        # 7 days  — movie metadata rarely changes
CACHE_TTL_AVAILABILITY=259200 # 3 days  — availability changes more often
CACHE_TTL_SEARCH=3600         # 1 hour  — search results
CACHE_TTL_DEVICE_SESSION=3600 # 1 hour  — active device sessions
